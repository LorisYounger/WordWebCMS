<article class="article"><header class="article-header"><h1>{{ post.title }}</h1><div class="meta"><a href="{{ post.archive_url }}"><i class="ri-calendar-line" aria-hidden="true"></i> <time data-local-time="date" datetime="{{ post.date_utc }}">{{ post.date }} UTC</time></a><a class="author-link" href="{{ post.author_url }}">{% unless site.hide_user_avatars %}<img class="avatar" src="{{ post.avatar }}" width="24" height="24" alt="" loading="lazy">{% endunless %}<span>{{ post.author }}</span></a><span><i class="ri-eye-line" aria-hidden="true"></i> {{ post.views }} {{ '阅读' | t }}</span></div>{% if post.summary != blank %}<p class="lead">{{ post.summary }}</p>{% endif %}{% if post.category != blank %}<a class="tag" href="{{ post.category_url }}">{{ post.category }}</a>{% endif %}</header>
{% if post.cover != blank %}<img class="article-cover" src="{{ post.cover }}" alt="">{% endif %}
<div class="prose">{{ post.html | raw }}</div><div class="tags">{% for tag in tags %}<a class="tag" href="{{ tag.url }}"># {{ tag.name }}</a>{% endfor %}</div>
<div class="article-actions"><span>{{ post.likes }} {{ '人点赞' | t }}</span>{% if signed_in %}<form method="post" action="{{ post.url }}?handler=Like"><input type="hidden" name="__RequestVerificationToken" value="{{ csrf }}"><button name="liked" value="{% if post.liked %}false{% else %}true{% endif %}">{% if post.liked %}{{ '取消赞' | t }}{% else %}{{ '点赞' | t }}{% endif %}</button></form>{% endif %}</div></article>
<section class="comments" id="comments"><h2><i class="ri-chat-3-line" aria-hidden="true"></i> {{ '评论' | t }}</h2>{% if notice != blank %}<p role="status" class="notice">{{ notice }}</p>{% endif %}
{% for comment in comments %}<article class="comment" id="comment-{{ comment.id }}"><div class="meta"><a class="author-link" href="{{ comment.author_url }}">{% unless site.hide_user_avatars %}<img class="avatar" src="{{ comment.avatar }}" width="24" height="24" alt="" loading="lazy">{% endunless %}<span>{{ comment.author }}</span></a><time data-local-time="datetime" datetime="{{ comment.date_utc }}">{{ comment.date }} UTC</time>#{{ comment.id }}{% if comment.parent_id %} {{ '· 回复 #' | t }}{{ comment.parent_id }}{% endif %}</div><div class="prose">{{ comment.html | raw }}</div>
<div class="comment-actions"><span>{{ comment.likes }} {{ '赞' | t }}</span>{% if signed_in %}<form method="post" action="{{ post.url }}?handler=Like"><input type="hidden" name="__RequestVerificationToken" value="{{ csrf }}"><input type="hidden" name="commentId" value="{{ comment.id }}"><button class="text-button" name="liked" value="{% if comment.liked %}false{% else %}true{% endif %}">{% if comment.liked %}{{ '取消赞' | t }}{% else %}{{ '喜欢' | t }}{% endif %}</button></form>{% if comments_open %}<button class="text-button" type="button" data-reply="{{ comment.id }}">{{ '回复' | t }}</button>{% endif %}{% endif %}</div></article>{% else %}<p class="muted">{{ '还没有公开评论。' | t }}</p>{% endfor %}
<nav class="pagination">{% if comment_previous != blank %}<a href="{{ comment_previous }}">{{ '上一页评论' | t }}</a>{% endif %}{% if comment_next != blank %}<a href="{{ comment_next }}">{{ '下一页评论' | t }}</a>{% endif %}</nav>
{% if comments_open %}{% if signed_in %}<form method="post" action="{{ post.url }}?handler=Comment" id="comment-form"><h3>{{ '发表评论' | t }}</h3><input type="hidden" name="__RequestVerificationToken" value="{{ csrf }}"><input type="hidden" name="parentId" id="parent-id"><p id="reply-label" role="status"></p><button class="text-button" type="button" id="cancel-reply" hidden>{{ '取消回复' | t }}</button><label for="body">{{ '评论（支持 Markdown，不支持原始 HTML）' | t }}</label><textarea id="body" name="body" rows="6" maxlength="10000" required></textarea>{% if moderated %}<p class="muted">{{ '评论审核通过后公开显示。' | t }}</p>{% endif %}<button>{{ '提交评论' | t }}</button></form>{% else %}<p><a href="/Account/Login">{{ '登录' | t }}</a>{{ '或' | t }}<a href="/Account/Register">{{ '注册' | t }}</a>{{ '后参与讨论。' | t }}</p>{% endif %}{% else %}<p class="muted">{{ '这篇内容已关闭新评论。' | t }}</p>{% endif %}</section>
