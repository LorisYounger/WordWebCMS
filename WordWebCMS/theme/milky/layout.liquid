<!doctype html>
<html lang="{{ language }}">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ title }} · {{ site.title }}</title>
  <meta name="description" content="{{ description }}"><meta name="color-scheme" content="light dark">
  <link rel="icon" href="{{ site.avatar }}"><link rel="canonical" href="{{ canonical }}">
  <meta property="og:title" content="{{ title }}"><meta property="og:description" content="{{ description }}"><meta property="og:url" content="{{ canonical }}">
  <meta property="og:type" content="{% if post and is_page != true %}article{% else %}website{% endif %}">
  {% if cover != blank %}<meta property="og:image" content="{{ cover }}">{% endif %}
  <link rel="alternate" type="application/rss+xml" href="{{ feed_url }}" title="{{ site.title }}">
  <script src="{{ theme_url | append: '/assets/appearance.js' | asset_url }}"></script>
  <link rel="stylesheet" href="{{ theme_url | append: '/assets/site.css' | asset_url }}">
<link rel="stylesheet" href="{{ '/css/icons.css' | asset_url }}"><link rel="stylesheet" href="{{ '/css/ui.css' | asset_url }}">
</head>
<body id="top">
<a class="skip-link" href="#content">{{ '跳到正文' | t }}</a>
<header class="masthead">
  <div class="wrap header-inner">
    <a class="brand" href="/"><img src="{{ site.avatar }}" width="36" height="36" alt=""><span>{{ site.title }}</span></a>
    {% if site.description != blank %}<p class="tagline">{{ site.description }}</p>{% endif %}
    <button class="icon-button menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" aria-label="{{ '菜单' | t }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
    <nav id="primary-nav" class="primary-nav" aria-label="{{ '主导航' | t }}">
      <a href="/"{% if is_home %} aria-current="page"{% endif %}><i class="ri-home-line" aria-hidden="true"></i> {{ '首页' | t }}</a>
      {% for item in navigation %}<div class="nav-group">
        <a href="{{ item.url }}"{% if item.new_window %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ item.text }}</a>
        {% if item.children.size > 0 %}<details class="dropdown"><summary aria-label="{{ item.text }} · {{ '子菜单' | t }}">⌄</summary><div class="dropdown-panel">{% for child in item.children %}<a href="{{ child.url }}"{% if child.new_window %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ child.text }}</a>{% endfor %}</div></details>{% endif %}
      </div>{% endfor %}
      <details class="dropdown search-dropdown"><summary aria-label="{{ '搜索' | t }}"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></summary><form class="dropdown-panel search-form" action="/" method="get"><label class="sr-only" for="header-q">{{ '搜索文章' | t }}</label><input id="header-q" name="q" type="search" maxlength="200" value="{{ query }}" placeholder="{{ '搜索文章' | t }}" required><button class="button" type="submit"><i class="ri-search-line" aria-hidden="true"></i> {{ '搜索' | t }}</button></form></details>
      <button class="icon-button appearance-toggle" type="button" aria-label="{{ '深色模式' | t }}" aria-pressed="false"><svg class="moon-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 15.3A8.7 8.7 0 0 1 8.7 4 8.7 8.7 0 1 0 20 15.3Z"/></svg><svg class="sun-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 1v2m0 18v2M1 12h2m18 0h2M4 4l2 2m12 12 2 2M4 20l2-2M18 6l2-2"/></svg></button>
    </nav>
  </div>
</header>
{% unless is_home %}<div class="breadcrumb-bar"><nav class="wrap breadcrumbs" aria-label="{{ '当前位置' | t }}"><a href="/">{{ site.title }}</a><span aria-hidden="true">›</span>{% if post.category != blank %}<a href="{{ post.category_url }}">{{ post.category }}</a><span aria-hidden="true">›</span>{% endif %}<span>{% if post %}{{ '正文' | t }}{% else %}{{ title }}{% endif %}</span></nav></div>{% endunless %}
<div class="wrap site-grid{% if is_page %} single-column{% endif %}">
  <main id="content" tabindex="-1">{{ body | raw }}</main>
  {% unless is_page %}<aside class="sidebar" aria-label="{{ '站点侧栏' | t }}">
    {% if is_home %}
    <section class="panel widget"><h2 class="section-title">{{ '近期文章' | t }}</h2><ul class="recent-list">{% for item in recent_posts %}<li><a href="{{ item.url }}">{{ item.title }}</a><time data-local-time="date" datetime="{{ item.date_utc }}">{{ item.date }} UTC</time></li>{% else %}<li class="muted">{{ '暂无文章。' | t }}</li>{% endfor %}</ul></section>
    {% endif %}
    {% assign recommendations = featured_posts %}{% if recommendations.size == 0 %}{% assign recommendations = recent_posts %}{% endif %}
    {% if recommendations.size > 0 %}<section class="panel widget"><h2 class="section-title">{% if featured_posts.size > 0 %}{{ '推荐' | t }}{% else %}{{ '近期文章' | t }}{% endif %}</h2><div class="recommend-list">{% for item in recommendations limit: 3 %}<a class="recommend-item{% if item.cover == blank %} no-cover{% endif %}" href="{{ item.url }}">{% if item.cover != blank %}<img src="{{ item.cover }}" width="108" height="76" alt="" loading="lazy">{% endif %}<span><strong>{{ item.title }}</strong><time data-local-time="date" datetime="{{ item.date_utc }}">{{ item.date }} UTC</time></span></a>{% endfor %}</div></section>{% endif %}
    <section class="panel widget"><h2 class="section-title">{{ '网站统计' | t }}</h2><dl class="site-stats"><div><dt>{{ '文章' | t }}</dt><dd>{{ site_stats.posts }}</dd></div><div><dt><i class="ri-chat-3-line" aria-hidden="true"></i> {{ '评论' | t }}</dt><dd>{{ site_stats.comments }}</dd></div><div><dt><i class="ri-price-tag-3-line" aria-hidden="true"></i> {{ '标签' | t }}</dt><dd>{{ site_stats.tags }}</dd></div><div><dt>{{ '最近发布' | t }}</dt><dd>{% if site_stats.latest_post != blank %}<time data-local-time="date" datetime="{{ site_stats.latest_post_utc }}">{{ site_stats.latest_post }} UTC</time>{% else %}—{% endif %}</dd></div></dl></section>
    {% if categories.size > 0 %}<section class="panel widget"><h2 class="section-title"><i class="ri-folder-line" aria-hidden="true"></i> {{ '分类' | t }}</h2><div class="category-links">{% for category in categories %}<a href="{{ category.url }}">{{ category.name }}</a>{% endfor %}</div></section>{% endif %}
    <section class="panel widget community"><h2 class="section-title">{{ '订阅' | t }}</h2><div class="widget-body"><a class="rss-link" href="{{ feed_url }}" target="_blank" rel="noopener noreferrer"><i class="ri-rss-line" aria-hidden="true"></i> RSS <span>{{ '订阅更新' | t }} <i class="ri-share-line" aria-hidden="true"></i></span></a></div></section>
  </aside>{% endunless %}
</div>
<footer class="site-footer wrap"><div class="footer-line"><span>{{ site.title }} <span class="footer-credit">· WordWebCMS / milky</span></span><a href="/sitemap.xml" target="_blank" rel="noopener noreferrer">{{ '站点地图' | t }}</a></div><div class="footer-line"><div class="account-nav">{% if signed_in %}<a class="author-link" href="{{ user_url }}">{{ user_name }}</a>{% if can_manage %}<a href="/Admin"><i class="ri-settings-3-line" aria-hidden="true"></i> {{ '管理后台' | t }}</a>{% endif %}<form action="/Account/Logout" method="post"><input type="hidden" name="__RequestVerificationToken" value="{{ csrf }}"><button class="text-button">{{ '退出' | t }}</button></form>{% else %}<a href="/Account/Login">{{ '登录' | t }}</a>{% if registration_open %}<a href="/Account/Register">{{ '注册' | t }}</a>{% endif %}{% endif %}</div><form class="language-nav" method="get" action="/language"><input type="hidden" name="returnUrl" value="{{ language_return }}"><label class="sr-only" for="site-language">{{ '语言' | t }}</label><select id="site-language" name="culture">{% for item in languages %}<option value="{{ item.code }}"{% if item.selected %} selected{% endif %}>{{ item.name }}</option>{% endfor %}</select><noscript><button>{{ '切换语言' | t }}</button></noscript></form></div></footer>
<a class="back-top" href="#top" aria-label="{{ '返回顶部' | t }}">↑</a>
<script id="ui-text" type="application/json">{{ client_messages | raw }}</script>
<script src="{{ theme_url | append: '/assets/site.js' | asset_url }}" defer></script>
<script src="{{ '/js/local-time.js' | asset_url }}" defer></script>
</body></html>
