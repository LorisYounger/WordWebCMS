{% if profile %}<section class="panel profile-card"><img class="avatar" src="{{ profile.avatar }}" width="80" height="80" alt=""><div><h1>{{ profile.name }}</h1><p class="profile-bio">{% if profile.bio != blank %}{{ profile.bio }}{% else %}{{ '这位作者还没有填写介绍。' | t }}{% endif %}</p>{% if profile.own %}<a class="text-button" href="/Account/Profile"><i class="ri-edit-line" aria-hidden="true"></i> {{ '编辑个人介绍' | t }}</a>{% endif %}</div></section>{% endif %}
{% if is_home and featured_posts.size > 0 %}{% assign featured = featured_posts | first %}<section class="panel featured-note"><h2><span>{{ '置顶文章' | t }}：</span><a href="{{ featured.url }}">{{ featured.title }}</a></h2>{% if featured.summary != blank %}<p>{{ featured.summary }}</p>{% endif %}</section>{% endif %}
<section class="panel post-list">
  <div class="list-heading"><h1 class="section-title">{{ heading }}</h1><span class="muted">{{ total }} {{ '篇' | t }}</span></div>
  {% for post in posts %}<article class="post-row{% if post.cover == blank %} no-cover{% endif %}">
    {% if post.cover != blank %}<a class="post-thumbnail" href="{{ post.url }}" tabindex="-1" aria-hidden="true"><img src="{{ post.cover }}" width="180" height="124" alt="" loading="lazy"></a>{% endif %}
    <div class="post-details"><h2>{% if post.pinned %}<span class="pin-badge">{{ '置顶' | t }}</span>{% endif %}<a href="{{ post.url }}">{{ post.title }}</a></h2>
      {% if post.summary != blank %}<p class="excerpt">{{ post.summary }}</p>{% endif %}
      <div class="post-meta"><a class="author-link" href="{{ post.author_url }}"><img class="avatar" src="{{ post.avatar }}" width="24" height="24" alt="" loading="lazy"><span>{{ post.author }}</span></a><time data-local-time="date" datetime="{{ post.date_utc }}">{{ post.date }} UTC</time>{% if post.category != blank %}<a href="{{ post.category_url }}">{{ post.category }}</a>{% endif %}<span><i class="ri-eye-line" aria-hidden="true"></i> {{ '阅读' | t }} ({{ post.views }})</span><a class="comment-link" href="{{ post.url }}#comments"><i class="ri-chat-3-line" aria-hidden="true"></i> {{ '评论' | t }}</a><span class="like-count"><i class="ri-heart-line" aria-hidden="true"></i> {{ post.likes }}</span></div>
    </div>
  </article>{% else %}<div class="empty-state"><span class="empty-mark" aria-hidden="true">M</span><h2>{{ '暂无文章' | t }}</h2><p>{{ '没有符合条件的公开文章。' | t }}</p><a class="button" href="/">{{ '查看全部文章' | t }}</a></div>{% endfor %}
  {% if total > 0 %}<nav class="pagination" aria-label="{{ '文章分页' | t }}">{% if previous != blank %}<a href="{{ previous }}"><i class="ri-arrow-left-line" aria-hidden="true"></i> {{ '上一页' | t }}</a>{% endif %}<span aria-current="page">{{ '第' | t }} {{ page }} {{ '页' | t }}</span>{% if next != blank %}<a href="{{ next }}">{{ '下一页' | t }} <i class="ri-arrow-right-line" aria-hidden="true"></i></a>{% endif %}</nav>{% endif %}
</section>
