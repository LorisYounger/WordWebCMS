<article class="panel article">
  <header class="article-header"><h1>{{ post.title }}</h1><div class="article-meta"><a href="{{ post.archive_url }}"><i class="ri-calendar-line" aria-hidden="true"></i> <time data-local-time="date" datetime="{{ post.date_utc }}">{{ post.date }} UTC</time></a><a class="author-link" href="{{ post.author_url }}">{% unless site.hide_user_avatars %}<img class="avatar" src="{{ post.avatar }}" width="24" height="24" alt="" loading="lazy">{% endunless %}<span>{{ post.author }}</span></a>{% if post.category != blank %}<a href="{{ post.category_url }}">{{ post.category }}</a>{% endif %}<span><i class="ri-eye-line" aria-hidden="true"></i> {{ '阅读' | t }} ({{ post.views }})</span><a href="#comments"><i class="ri-chat-3-line" aria-hidden="true"></i> {{ '评论' | t }} ({{ post.comment_count }})</a><span><i class="ri-heart-line" aria-hidden="true"></i> {{ post.likes }}</span></div></header>
  {% if post.cover != blank %}<img class="article-cover" src="{{ post.cover }}" alt="">{% endif %}
  <div class="prose">{{ post.html | raw }}</div>
  <div class="article-actions">{% if signed_in %}<form method="post" action="{{ post.url }}?handler=Like"><input type="hidden" name="__RequestVerificationToken" value="{{ csrf }}"><button class="button like-button" name="liked" value="{% if post.liked %}false{% else %}true{% endif %}" aria-pressed="{{ post.liked }}"><i class="ri-heart-line" aria-hidden="true"></i> {% if post.liked %}{{ '取消赞' | t }}{% else %}{{ '点赞' | t }}{% endif %} ({{ post.likes }})</button></form>{% else %}<a class="button like-button" href="/Account/Login?returnUrl={{ post.url | url_encode }}"><i class="ri-heart-line" aria-hidden="true"></i> {{ '点赞' | t }} ({{ post.likes }})</a>{% endif %}</div>
  <div class="share-area"><button class="text-button share-button" type="button" data-share data-success="{{ '链接已复制' | t }}" data-failure="{{ '请复制下方链接' | t }}"><i class="ri-share-line" aria-hidden="true"></i> {{ '分享文章' | t }}</button><p class="share-status muted" role="status"></p><input class="share-link" type="text" value="{{ canonical }}" aria-label="{{ '文章链接' | t }}" readonly hidden></div>
  {% if tags.size > 0 %}<div class="article-tags">{% for tag in tags %}<a href="{{ tag.url }}">{{ tag.name }}</a>{% endfor %}</div>{% endif %}
  {% if previous_post or next_post %}<nav class="article-neighbors" aria-label="{{ '文章导航' | t }}"><div>{% if previous_post %}<a href="{{ previous_post.url }}" rel="prev"><span><i class="ri-arrow-left-line" aria-hidden="true"></i> {{ '上一篇' | t }}</span>{{ previous_post.title }}</a>{% endif %}</div><div>{% if next_post %}<a href="{{ next_post.url }}" rel="next"><span>{{ '下一篇' | t }} <i class="ri-arrow-right-line" aria-hidden="true"></i></span>{{ next_post.title }}</a>{% endif %}</div></nav>{% endif %}
  {% if related_posts.size > 0 %}<section class="related"><h2 class="section-title">{{ '相关推荐' | t }}</h2><div class="related-grid">{% for item in related_posts %}<a href="{{ item.url }}"{% if item.cover == blank %} class="no-cover"{% endif %}>{% if item.cover != blank %}<img src="{{ item.cover }}" width="175" height="120" alt="" loading="lazy">{% endif %}<span class="related-title">{{ item.title }}</span></a>{% endfor %}</div></section>{% endif %}
</article>
<section class="panel comments" id="comments"><h2 class="section-title"><i class="ri-chat-3-line" aria-hidden="true"></i> {{ '评论' | t }} <span class="muted">({{ post.comment_count }})</span></h2>
  {% if notice != blank %}<p class="notice" role="status">{{ notice }}</p>{% endif %}
  {% for comment in comments %}<article class="comment" id="comment-{{ comment.id }}"><div class="comment-meta"><a class="author-link" href="{{ comment.author_url }}">{% unless site.hide_user_avatars %}<img class="avatar" src="{{ comment.avatar }}" width="24" height="24" alt="" loading="lazy">{% endunless %}<span>{{ comment.author }}</span></a><time data-local-time="datetime" datetime="{{ comment.date_utc }}">{{ comment.date }} UTC</time><span>#{{ comment.id }}{% if comment.parent_id %} {{ '· 回复 #' | t }}{{ comment.parent_id }}{% endif %}</span></div><div class="prose">{{ comment.html | raw }}</div><div class="comment-actions"><span class="muted">{{ comment.likes }} {{ '赞' | t }}</span>{% if signed_in %}<form method="post" action="{{ post.url }}?handler=Like"><input type="hidden" name="__RequestVerificationToken" value="{{ csrf }}"><input type="hidden" name="commentId" value="{{ comment.id }}"><button class="text-button" name="liked" value="{% if comment.liked %}false{% else %}true{% endif %}">{% if comment.liked %}{{ '取消赞' | t }}{% else %}{{ '喜欢' | t }}{% endif %}</button></form>{% if comments_open %}<button class="text-button reply-button" type="button" data-reply="{{ comment.id }}">{{ '回复' | t }}</button>{% endif %}{% endif %}</div></article>{% else %}<p class="muted comment-empty">{{ '还没有公开评论。' | t }}</p>{% endfor %}
  {% if comment_previous != blank or comment_next != blank %}<nav class="pagination" aria-label="{{ '评论' | t }}">{% if comment_previous != blank %}<a href="{{ comment_previous }}">{{ '上一页评论' | t }}</a>{% endif %}{% if comment_next != blank %}<a href="{{ comment_next }}">{{ '下一页评论' | t }}</a>{% endif %}</nav>{% endif %}
  {% if comments_open %}{% if signed_in %}<form method="post" action="{{ post.url }}?handler=Comment" id="comment-form"><h3>{{ '发表评论' | t }}</h3><input type="hidden" name="__RequestVerificationToken" value="{{ csrf }}"><input type="hidden" name="parentId" id="parent-id"><p id="reply-label" role="status"></p><button class="text-button" type="button" id="cancel-reply" hidden>{{ '取消回复' | t }}</button><label for="comment-body">{{ '评论（支持 Markdown，不支持原始 HTML）' | t }}</label><textarea id="comment-body" name="body" rows="5" maxlength="10000" required></textarea>{% if moderated %}<p class="muted">{{ '评论审核通过后公开显示。' | t }}</p>{% endif %}<button class="button">{{ '提交评论' | t }}</button></form>{% else %}<p class="login-prompt"><a href="/Account/Login?returnUrl={{ post.url | url_encode }}">{{ '登录' | t }}</a>{% if registration_open %} {{ '或' | t }} <a href="/Account/Register">{{ '注册' | t }}</a>{% endif %} {{ '后参与讨论。' | t }}</p>{% endif %}{% else %}<p class="muted">{{ '这篇内容已关闭新评论。' | t }}</p>{% endif %}
</section>
