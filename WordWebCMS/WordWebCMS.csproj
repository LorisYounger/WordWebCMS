<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WordWebCMS</RootNamespace>
    <AssemblyName>WordWebCMS</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="*.aspx.cs" />
    <Compile Remove="*.aspx.designer.cs" />
    <Compile Remove="AJAX.ashx.cs" />
    <None Include="*.aspx" />
    <None Include="*.aspx.cs" />
    <None Include="*.aspx.designer.cs" />
    <None Include="AJAX.ashx" />
    <None Include="AJAX.ashx.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.3.7" />
    <PackageReference Include="Markdig" Version="0.37.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="LinePutScript">
      <HintPath>../packages/LinePutScript.1.3.1/lib/net6.0/LineputScript.dll</HintPath>
    </Reference>
    <Reference Include="LinePutScript.SQLHelper.Core">
      <HintPath>../packages/LinePutScript.SQLHelper.1.1.7/lib/net5.0/LinePutScript.SQLHelper.Core.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
