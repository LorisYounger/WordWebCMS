<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FreeSql.Provider.MySqlConnector" Version="3.5.311" />
    <PackageReference Include="Fluid.Core" Version="2.40.0" />
    <PackageReference Include="HtmlSanitizer" Version="9.2.1039" />
    <PackageReference Include="Markdig" Version="1.5.0" />
    <PackageReference Include="MailKit" Version="4.18.2" />
    <Content Remove="theme/**/*" />
    <Content Update="Languages/**/*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="theme/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Remove="App_Data/**/*" />
    <None Remove="App_Data/**/*" />
    <Content Remove="**/setup.json;**/setup.json.tmp" />
    <None Remove="**/setup.json;**/setup.json.tmp" />
  </ItemGroup>

</Project>
