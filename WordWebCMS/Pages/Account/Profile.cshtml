@page
@model WordWebCMS.Pages.Account.ProfileModel
@{ ViewData["Title"] = UiText.T("编辑个人资料"); }
<section class="card profile-editor">
<h1>@UiText.T("编辑个人资料")</h1>
<a class="author-link" href="@PublicUrls.Author(User.Identity!.Name!)"><img class="avatar" src="@ShortLinks.Avatar(User.Identity.Name!, Model.AvatarUrl)" width="28" height="28" alt="" />@User.Identity.Name</a>
<form method="post"><div asp-validation-summary="All" role="alert"></div>
<label asp-for="AvatarUrl">@UiText.T("头像 URL")</label><input asp-for="AvatarUrl" maxlength="1000" placeholder="https://…" />
<p class="help">@UiText.T("留空会使用默认头像。也可以填写媒体库中的图片地址，或 HTTP(S) 图片链接。")</p>
<label asp-for="Bio">@UiText.T("个人介绍")</label><textarea asp-for="Bio" maxlength="1000" rows="6"></textarea>
<p class="help">@UiText.T("介绍会公开显示在你的用户主页。")</p>
<button type="submit"><i class="ri-save-line" aria-hidden="true"></i> @UiText.T("保存")</button>
</form></section>
