@page
@model WordWebCMS.Pages.Admin.IndexModel
@{ ViewData["ContentKind"] = Model.Kind ?? PostKind.Article; ViewData["Title"] = UiText.T("文章与页面"); }
<div class="page-heading split"><h1>@UiText.T("文章与页面")</h1>
<form method="post" asp-page-handler="Create" class="inline"><select name="kind" aria-label="@UiText.T("新建内容类型")"><option value="Article" selected="@(Model.Kind != PostKind.Page)">@UiText.T("文章")</option><option value="Page" selected="@(Model.Kind == PostKind.Page)">@UiText.T("独立页面")</option></select><button>@UiText.T("新建")</button></form></div>
<form method="get" class="filter-bar">
<div class="inline"><select asp-for="Kind" aria-label="@UiText.T("筛选内容类型")"><option value="">@UiText.T("全部类型")</option><option value="Article">@UiText.T("文章")</option><option value="Page">@UiText.T("独立页面")</option></select>
<select asp-for="Status" aria-label="@UiText.T("筛选状态")"><option value="">@UiText.T("全部状态")</option><option value="published">@UiText.T("已发布")</option><option value="draft">@UiText.T("草稿")</option><option value="pending">@UiText.T("待审核")</option><option value="hidden">@UiText.T("已撤下")</option></select><button class="secondary">@UiText.T("筛选")</button></div>
<div class="search"><input asp-for="Q" placeholder="@UiText.T("搜索标题")" aria-label="@UiText.T("搜索标题")" /><button class="secondary">@UiText.T("搜索")</button></div>
</form>
<div class="table-caption"><span>@UiText.Format("共 {0} 项", Model.Total)</span><span>@UiText.Format("第 {0} / {1} 页", Model.P, Model.Pages)</span></div>
<div class="table-wrap content-table"><table><caption class="sr-only">@UiText.T("文章与页面列表，分类和更新时间以当前草稿为准")</caption><thead><tr><th scope="col">@UiText.T("标题")</th><th scope="col">@UiText.T("作者")</th><th scope="col">@UiText.T("分类")</th><th scope="col">@UiText.T("状态")</th><th scope="col">@UiText.T("阅读")</th><th scope="col">@UiText.T("草稿更新")</th></tr></thead><tbody>
@if (Model.Posts.Count == 0) { <tr><td colspan="6" class="empty">@UiText.T("没有符合条件的内容。")</td></tr> }
@foreach (var post in Model.Posts) { var draft = Model.Drafts[post.Id];
<tr><td class="title-cell"><a class="row-title" asp-page="Edit" asp-route-id="@post.Id">@(draft.Title.Length == 0 ? UiText.T("未命名内容") : draft.Title)</a>
<span class="post-kind">@(post.Kind == PostKind.Page ? UiText.T("页面") : UiText.T("文章"))@if (post.PinOrder != 0) { <span> · @UiText.Format("置顶 {0}", post.PinOrder)</span> }</span>
<div class="row-actions"><a asp-page="Edit" asp-route-id="@post.Id">@UiText.T("编辑")</a>
@if (post.IsPublic) { <a href="/@post.Slug">@UiText.T("查看")</a> }
@if (AccountService.CanEditAll(User) && post.PublishedRevisionId != null) {
<form method="post" asp-page-handler="Visibility"><input type="hidden" name="id" value="@post.Id" /><input type="hidden" name="visible" value="@(!post.IsPublic)" /><input type="hidden" name="pinOrder" value="@post.PinOrder" /><button class="link">@(post.IsPublic ? UiText.T("撤下") : UiText.T("重新发布"))</button></form>
}
@if (AccountService.CanEditAll(User) || post.PublishedRevisionId == null) {
<form method="post" asp-page-handler="Delete" data-confirm="@UiText.T("永久删除这篇内容及其修订、评论和点赞？")"><input type="hidden" name="id" value="@post.Id" /><button class="link danger-link">@UiText.T("删除")</button></form>
}
</div>
@if (AccountService.CanEditAll(User) && post.PublishedRevisionId != null) {
<details class="pin-settings"><summary>@UiText.T("置顶排序")</summary><form method="post" asp-page-handler="Visibility" class="inline"><input type="hidden" name="id" value="@post.Id" /><input type="hidden" name="visible" value="@post.IsPublic" /><input type="number" name="pinOrder" value="@post.PinOrder" aria-label="@UiText.T("置顶顺序，越大越靠前，0 不置顶")" class="compact" /><button class="secondary">@UiText.T("保存")</button></form></details>
}
</td><td>@Model.Authors.GetValueOrDefault(post.AuthorId, UiText.T("用户"))</td><td>@(draft.CategoryId.HasValue ? Model.Categories.GetValueOrDefault(draft.CategoryId.Value, UiText.T("未分类")) : UiText.T("未分类"))</td>
<td><span class="badge">@(post.IsPublic ? UiText.T("已发布") : post.PublishedRevisionId == null ? UiText.T("草稿") : UiText.T("已撤下"))</span>@if (Model.Pending.Contains(post.Id)) { <span class="badge accent">@UiText.T("待审核")</span> }</td>
<td>@post.Views</td><td class="date-cell"><time data-local-time="datetime" datetime="@PublicUrls.Utc(draft.UpdatedUtc)">@draft.UpdatedUtc.ToString("yyyy-MM-dd")<br />@draft.UpdatedUtc.ToString("HH:mm")</time></td></tr>
}
</tbody></table></div>
<nav class="pagination" aria-label="@UiText.T("内容分页")"><span>@UiText.Format("共 {0} 项", Model.Total)</span><div class="inline">
@if (Model.P > 1) { <a class="button secondary" asp-route-p="@(Model.P - 1)" asp-route-q="@Model.Q" asp-route-kind="@Model.Kind" asp-route-status="@Model.Status">@UiText.T("上一页")</a> }
<span>@UiText.Format("第 {0} / {1} 页", Model.P, Model.Pages)</span>
@if (Model.P < Model.Pages) { <a class="button secondary" asp-route-p="@(Model.P + 1)" asp-route-q="@Model.Q" asp-route-kind="@Model.Kind" asp-route-status="@Model.Status">@UiText.T("下一页")</a> }
</div></nav>
