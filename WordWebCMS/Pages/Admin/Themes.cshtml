@page
@model WordWebCMS.Pages.Admin.ThemesModel
@{ ViewData["Title"] = UiText.T("主题管理"); }
<div class="page-heading"><h1>@UiText.T("主题管理")</h1><p>@UiText.T("管理前台使用的主题。")</p></div>
<form method="post" asp-page-handler="Upload" enctype="multipart/form-data" class="card form-panel"><h2>@UiText.T("安装主题")</h2><p>@UiText.T("ZIP 根目录需要有 theme.json、layout.liquid、list.liquid、post.liquid、error.liquid，静态资源请放在 assets/ 目录。主题可以修改前台的 HTML 和脚本，请只安装你信任的主题。")</p><label for="upload">@UiText.T("主题 ZIP（最大 20 MB）")</label><input id="upload" type="file" name="upload" accept=".zip" required /><div class="form-actions"><button>@UiText.T("上传安装")</button></div></form>
<section class="card">@foreach (var theme in Model.Themes) { <div class="list-row"><div><h2>@theme.Name</h2><small>@theme.Id · @UiText.T("协议版本") @(theme.Version)</small></div>@if (theme.Id == Model.Current) { <span class="badge accent">@UiText.T("当前主题")</span> } else { <form method="post" asp-page-handler="Activate"><input type="hidden" name="theme" value="@theme.Id" /><button class="secondary">@UiText.T("启用")</button></form> }</div> }</section>
