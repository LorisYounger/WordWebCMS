@page
@model WordWebCMS.Pages.Admin.SettingsModel
@{ ViewData["Title"] = UiText.T("站点设置"); }
<div class="page-heading"><h1>@UiText.T("站点设置")</h1></div>
@if (TempData["Saved"] != null) { <p class="notice" role="status">@UiText.T("设置已保存。")</p> }
<form method="post" class="settings-form">
<section class="card"><h2 class="panel-heading">@UiText.T("常规")</h2>
<div class="setting-row"><label asp-for="Settings.Title">@UiText.T("站点名称")</label><div><input asp-for="Settings.Title" maxlength="120" required /></div></div>
<div class="setting-row"><label asp-for="Settings.AvatarUrl">@UiText.T("站点头像地址")</label><div><input asp-for="Settings.AvatarUrl" maxlength="1000" /><p class="help">@UiText.T("留空会使用 WWC.png。也可以填写媒体库中的图片地址，或 HTTP(S) 图片链接。")</p><img class="avatar site-avatar" src="@(string.IsNullOrEmpty(Model.Settings.AvatarUrl) ? "/WWC.png" : Model.Settings.AvatarUrl)" alt="" /></div></div>
<div class="setting-row"><span>@UiText.T("启用语言")</span><div>@foreach (var culture in UiText.Cultures) { <label class="check"><input type="checkbox" name="SelectedLanguages" value="@culture.Name" checked="@Model.SelectedLanguages.Contains(culture.Name)" />@culture.NativeName (@culture.Name)</label> }<p class="help">@UiText.T("要添加其他语言，请先把语言包放到持久存储目录下的 languages 文件夹中。重启站点后，就能在这里选择。")</p></div></div>
<div class="setting-row"><label asp-for="Settings.Language">@UiText.T("默认语言")</label><select asp-for="Settings.Language">@foreach (var culture in UiText.Cultures) { <option value="@culture.Name">@culture.NativeName</option> }</select></div>
<div class="setting-row"><label asp-for="Settings.Description">@UiText.T("站点描述")</label><div><textarea asp-for="Settings.Description" maxlength="500" rows="3" aria-describedby="description-help"></textarea><p id="description-help" class="help">@UiText.T("显示在站点标题下方。")</p></div></div>
<div class="setting-row"><span>@UiText.T("用户头像")</span><div><label class="check"><input asp-for="Settings.HideUserAvatars" />@UiText.T("在主页和文章中隐藏用户头像")</label><p class="help">@UiText.T("同时隐藏文章列表、评论和前台导航中的用户头像，保留作者名称与个人资料页头像。站点图标不受影响。")</p></div></div>
<div class="setting-row"><label asp-for="Settings.FooterMarkdown">@UiText.T("站点页脚")</label><div><textarea asp-for="Settings.FooterMarkdown" maxlength="10000" rows="5"></textarea><p class="help">@UiText.T("支持 Markdown、链接和换行，可填写版权、备案号与联系方式。留空使用默认页脚；不支持脚本。")</p></div></div>
<div class="setting-row"><label asp-for="Settings.BaseUrl">@UiText.T("站点地址（URL）")</label><div><input asp-for="Settings.BaseUrl" type="url" maxlength="500" required aria-describedby="url-help" /><p id="url-help" class="help">@UiText.T("用于邮件、RSS、站点地图和分享链接。")</p></div></div>
</section>
<section class="card"><h2 class="panel-heading">@UiText.T("站点名称、描述与页脚译文")</h2><p class="help">@UiText.T("没有译文时，中文会显示简体中文内容，其他语言会显示英文内容；如果仍为空，就显示站点默认内容。停用语言不会删除已有译文。")</p>
@foreach (var culture in UiText.Cultures.Where(c => c.Name != Model.Settings.Language)) { var translation = Model.Translations.GetValueOrDefault(culture.Name) ?? new SiteTranslation();
<details><summary>@culture.NativeName (@culture.Name)</summary><label for="site-title-@culture.Name">@UiText.T("站点名称")</label><input id="site-title-@culture.Name" name="Translations[@culture.Name].Title" value="@translation.Title" maxlength="120" /><label for="site-description-@culture.Name">@UiText.T("站点描述")</label><textarea id="site-description-@culture.Name" name="Translations[@culture.Name].Description" maxlength="500" rows="3">@translation.Description</textarea><label for="site-footer-@culture.Name">@UiText.T("站点页脚")</label><textarea id="site-footer-@culture.Name" name="Translations[@culture.Name].FooterMarkdown" maxlength="10000" rows="5">@translation.FooterMarkdown</textarea></details>
}</section>
<section class="card"><h2 class="panel-heading">@UiText.T("注册管理")</h2><div class="setting-row"><label asp-for="Settings.Registration">@UiText.T("注册模式")</label><select asp-for="Settings.Registration"><option value="Open">@UiText.T("开放注册")</option><option value="Closed">@UiText.T("关闭注册")</option><option value="Approval">@UiText.T("管理员审核")</option></select></div><p class="help">@UiText.T("所有账号都需要先验证邮箱，再进入管理员审核。开启管理员审核后，共享账号首次加入本站也要经过审核。")</p><a href="/Admin/Users">@UiText.T("管理注册申请")</a></section>
<section class="card"><h2 class="panel-heading">@UiText.T("评论")</h2>
<div class="setting-row"><span>@UiText.T("评论权限")</span><div><label class="check"><input asp-for="Settings.CommentsEnabled" />@UiText.T("允许发表新评论")</label><p class="help">@UiText.T("关闭后保留已有评论。")</p></div></div>
<div class="setting-row"><span>@UiText.T("评论审核")</span><div><label class="check"><input asp-for="Settings.ModerateComments" />@UiText.T("新评论需审核后显示")</label></div></div>
</section><button>@UiText.T("保存设置")</button></form>
<form method="post" asp-page-handler="Mail" class="settings-form">
<section class="card"><h2 class="panel-heading">@UiText.T("邮件服务（SMTP）")</h2>
@if (TempData["MailSaved"] != null) { <p class="notice" role="status">@UiText.T("邮件设置已保存并生效。")</p> }
<p class="help">@UiText.T("注册验证和找回密码时会用到邮件服务，设置保存后立即生效。如需停用，请同时清空服务器和发件地址。")</p>
<div class="setting-row"><label asp-for="Mail.Host">@UiText.T("SMTP 服务器")</label><div><input asp-for="Mail.Host" maxlength="253" placeholder="smtp.example.com" /><p class="help">@UiText.T("填写主机名或 IP 地址，不要加协议和端口。")</p></div></div>
<div class="setting-row"><label asp-for="Mail.Port">@UiText.T("SMTP 端口")</label><input asp-for="Mail.Port" type="number" min="1" max="65535" required /></div>
<div class="setting-row"><label asp-for="Mail.Security">@UiText.T("连接加密")</label><div><select asp-for="Mail.Security"><option value="StartTls">STARTTLS</option><option value="SslOnConnect">SSL/TLS</option><option value="None">@UiText.T("不加密（仅本地测试）")</option></select><p class="help">@UiText.T("587 端口通常使用 STARTTLS，465 端口使用 SSL/TLS，具体请按邮件服务商的要求选择。")</p></div></div>
<div class="setting-row"><label asp-for="Mail.From">@UiText.T("发件地址")</label><input asp-for="Mail.From" type="email" maxlength="254" placeholder="noreply@example.com" /></div>
<div class="setting-row"><label asp-for="Mail.User">@UiText.T("SMTP 用户名")</label><div><input asp-for="Mail.User" maxlength="320" autocomplete="off" /><p class="help">@UiText.T("通常填写邮箱地址。如果服务器不要求登录，可以留空。")</p></div></div>
<div class="setting-row"><label asp-for="Mail.Password">@UiText.T("SMTP 密码或授权码")</label><div><input asp-for="Mail.Password" type="password" maxlength="4096" autocomplete="new-password" /><p class="help">@UiText.T(Model.HasMailPassword ? "已保存密码，留空即可继续使用。要更换密码，请在这里填写新密码。" : "还没有保存密码，请填写邮件服务商提供的密码或授权码。")</p><label class="check"><input asp-for="ClearMailPassword" />@UiText.T("清除已保存的 SMTP 密码")</label></div></div>
</section><button>@UiText.T("保存邮件设置")</button></form>
